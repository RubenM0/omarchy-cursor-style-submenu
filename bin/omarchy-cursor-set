#!/bin/bash
# Apply an Xcursor theme or size and keep it across login.
# The compositor cursor, gsettings, GTK settings, ~/.icons/default, Hyprland
# hl.env, and the systemd activation environment are updated together.
# A requested size is snapped to a bitmap the theme actually ships. Hyprland
# keeps that logical size. XWayland is unscaled, so XCURSOR_SIZE is the nearest
# shipped bitmap to logical size times the focused monitor scale.
# Desktop apps are systemd scopes and copy the shell's environment, so the
# shell is restarted after a change. Already-open apps keep the cursor they
# loaded until they are restarted. Pointer speed is Hyprland's
# input.sensitivity, from -1 to 1. omarchy-cursor-current prints the active
# theme name. omarchy-cursor-size prints the active logical size.
# omarchy-cursor-speed prints the active sensitivity.

set -euo pipefail

HYPR_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.lua"
HYPR_INPUT="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/input.lua"
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)

cursor_current() {
  local theme
  theme=$(gsettings get org.gnome.desktop.interface cursor-theme 2>/dev/null || true)
  theme=${theme#\'}
  theme=${theme%\'}
  printf '%s\n' "$theme"
}

cursor_size() {
  local size
  size=$(gsettings get org.gnome.desktop.interface cursor-size 2>/dev/null || true)
  size=${size//[^0-9]/}
  if [[ -z $size && -f $HYPR_CONFIG ]]; then
    size=$(sed -n 's/^hl.env("HYPRCURSOR_SIZE", "\([0-9][0-9]*\)").*/\1/p' "$HYPR_CONFIG" | head -1)
    if [[ -z $size ]]; then
      size=$(sed -n 's/^hl.env("XCURSOR_SIZE", "\([0-9][0-9]*\)").*/\1/p' "$HYPR_CONFIG" | head -1)
    fi
  fi
  printf '%s\n' "${size:-24}"
}

# Print a stable label. Menu checks compare against these exact strings.
cursor_speed() {
  hyprctl getoption input:sensitivity -j 2>/dev/null | python3 -c '
import json, sys
raw = sys.stdin.read().strip()
value = 0.0
if raw:
    try:
        value = float(json.loads(raw).get("float", 0))
    except (json.JSONDecodeError, TypeError, ValueError):
        value = 0.0
steps = (
    (-1, "-1"),
    (-0.75, "-0.75"),
    (-0.5, "-0.5"),
    (-0.25, "-0.25"),
    (0, "0"),
    (0.25, "0.25"),
    (0.5, "0.5"),
    (0.75, "0.75"),
    (1, "1"),
)
for step, label in steps:
    if abs(value - step) < 0.001:
        print(label)
        break
else:
    text = f"{value:.4f}".rstrip("0").rstrip(".")
    print("0" if text in ("", "-0") else text)
'
}

# First Inherits= name, with surrounding whitespace removed. Spaces inside the
# name stay: "DMZ White" is a theme, not two tokens.
first_inherit() {
  local inherits=$1
  inherits=${inherits%%,*}
  inherits=${inherits#"${inherits%%[![:space:]]*}"}
  inherits=${inherits%"${inherits##*[![:space:]]}"}
  printf '%s\n' "$inherits"
}

# Hyprland needs a theme directory that contains cursors/. Omarchy's "default"
# theme only inherits Adwaita, so follow one Inherits= hop when needed.
# ~/.icons/default is our own XWayland fallback, so never treat it as the source
# of the stock theme.
hypr_theme() {
  local theme=$1 dir inherits
  if [[ $theme == default ]]; then
    inherits=$(sed -n 's/^Inherits=//p' /usr/share/icons/default/index.theme 2>/dev/null | head -1)
    inherits=$(first_inherit "$inherits")
    printf '%s\n' "${inherits:-Adwaita}"
    return
  fi
  for dir in "$HOME/.local/share/icons" "$HOME/.icons" /usr/share/icons; do
    if [[ -d $dir/$theme/cursors ]]; then
      printf '%s\n' "$theme"
      return
    fi
  done
  for dir in "$HOME/.local/share/icons" "$HOME/.icons" /usr/share/icons; do
    if [[ -f $dir/$theme/index.theme ]]; then
      inherits=$(sed -n 's/^Inherits=//p' "$dir/$theme/index.theme" | head -1)
      inherits=$(first_inherit "$inherits")
      if [[ -n $inherits ]]; then
        printf '%s\n' "$inherits"
        return
      fi
    fi
  done
  printf '%s\n' "$theme"
}

persist_hypr() {
  local theme=$1 hypr_size=$2 xcursor_size=$3
  python3 - "$HYPR_CONFIG" "$theme" "$hypr_size" "$xcursor_size" << 'PY'
import os, re, sys
path, theme, hypr_size, xcursor_size = sys.argv[1:]
lua = theme.replace("\\", "\\\\").replace('"', '\\"')
text = open(path).read() if os.path.exists(path) else ""
if text and not text.endswith("\n"):
    text += "\n"
replacements = {
    "XCURSOR_THEME": f'hl.env("XCURSOR_THEME", "{lua}")\n',
    "HYPRCURSOR_THEME": f'hl.env("HYPRCURSOR_THEME", "{lua}")\n',
    "XCURSOR_SIZE": f'hl.env("XCURSOR_SIZE", "{xcursor_size}")\n',
    "HYPRCURSOR_SIZE": f'hl.env("HYPRCURSOR_SIZE", "{hypr_size}")\n',
}
for key, repl in replacements.items():
    pat = re.compile(rf'^hl\.env\("{key}", ".*"\)\n', re.M)
    if pat.search(text):
        text = pat.sub(repl, text, count=1)
    else:
        text += repl
if os.path.exists(path) and open(path).read() == text:
    raise SystemExit(0)
os.makedirs(os.path.dirname(path), exist_ok=True)
open(path, "w").write(text)
PY
}

# GTK reads settings.ini. XWayland and Electron fall back to ~/.icons/default.
# The gsettings name stays "default" for Omarchy's stock cursor; the X fallback
# must inherit Adwaita, because the default theme has no cursors/ of its own.
write_desktop_cursor() {
  local theme=$1 size=$2 inherits=$3
  local config="${XDG_CONFIG_HOME:-$HOME/.config}"
  python3 - "$theme" "$size" "$inherits" \
    "$config/gtk-3.0/settings.ini" \
    "$config/gtk-4.0/settings.ini" \
    "$HOME/.icons/default/index.theme" << 'PY'
import os, sys
theme, size, inherits, gtk3, gtk4, index = sys.argv[1:]

def write_if_changed(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    if os.path.exists(path) and open(path, encoding="utf-8").read() == text:
        return
    open(path, "w", encoding="utf-8").write(text)

def update_ini(path, section, updates):
    original = open(path, encoding="utf-8").read() if os.path.exists(path) else ""
    newline = "\r\n" if "\r\n" in original else "\n"
    lines = original.splitlines()
    header = f"[{section}]"
    start = next((i for i, line in enumerate(lines) if line.strip() == header), None)
    if start is None:
        if lines and lines[-1].strip():
            lines.append("")
        lines.append(header)
        lines.extend(f"{key}={value}" for key, value in updates.items())
    else:
        end = len(lines)
        for i in range(start + 1, len(lines)):
            stripped = lines[i].strip()
            if stripped.startswith("[") and stripped.endswith("]"):
                end = i
                break
        seen = set()
        for i in range(start + 1, end):
            stripped = lines[i].strip()
            if not stripped or stripped[0] in "#;":
                continue
            key = stripped.split("=", 1)[0].strip()
            if key in updates:
                lines[i] = f"{key}={updates[key]}"
                seen.add(key)
        missing = [f"{key}={value}" for key, value in updates.items() if key not in seen]
        if missing:
            lines[end:end] = missing
    text = newline.join(lines)
    if text and not text.endswith(newline):
        text += newline
    write_if_changed(path, text)

updates = {}
if theme:
    updates["gtk-cursor-theme-name"] = theme
if size:
    updates["gtk-cursor-theme-size"] = size
if updates:
    for path in (gtk3, gtk4):
        update_ini(path, "Settings", updates)

if inherits:
    if not os.path.exists(index) or os.path.getsize(index) == 0:
        write_if_changed(
            index,
            "[Icon Theme]\n"
            "Name=Default\n"
            "Comment=Default Cursor Theme\n"
            f"Inherits={inherits}\n",
        )
    else:
        update_ini(index, "Icon Theme", {"Inherits": inherits})
PY
}

# Bitmap sizes stored in the theme's left_ptr cursor. One size per line.
theme_sizes() {
  python3 "$SCRIPT_DIR/omarchy-cursor-menu" --sizes "$1"
}

# Closest shipped size. A tie prefers the larger bitmap so an unscaled
# XWayland cursor is not smaller than the scaled desktop cursor.
nearest_size() {
  local target=$1
  shift
  python3 -c '
import sys
target = float(sys.argv[1])
sizes = [int(size) for size in sys.argv[2:]]
if not sizes:
    raise SystemExit(1)
print(min(sizes, key=lambda size: (abs(size - target), -size)))
' "$target" "$@"
}

monitor_scale() {
  hyprctl monitors -j 2>/dev/null | python3 -c '
import json, sys
try:
    monitors = json.load(sys.stdin)
except Exception:
    print("1")
    raise SystemExit(0)
if not isinstance(monitors, list) or not monitors:
    print("1")
    raise SystemExit(0)
chosen = next((monitor for monitor in monitors if monitor.get("focused")), monitors[0])
try:
    scale = float(chosen.get("scale") or 1)
except (TypeError, ValueError):
    scale = 1.0
if scale <= 0:
    scale = 1.0
text = f"{scale:.4f}".rstrip("0").rstrip(".")
print(text or "1")
'
}

# hypr_size is the logical size Hyprland scales. xcursor_size is the bitmap
# XWayland draws at 1:1 because force_zero_scaling is on.
publish_cursor_env() {
  local theme=$1 hypr_size=$2 xcursor_size=$3 lua
  if [[ -z $theme || $theme == default ]]; then
    echo "omarchy-cursor-set: refusing to publish a cursor theme with no cursors/" >&2
    return 1
  fi
  if [[ ! $hypr_size =~ ^[1-9][0-9]*$ || ! $xcursor_size =~ ^[1-9][0-9]*$ ]]; then
    echo "omarchy-cursor-set: refusing to publish cursor size: ${hypr_size:-<empty>}/${xcursor_size:-<empty>}" >&2
    return 1
  fi
  lua=$(python3 -c '
import sys
theme, hypr_size, xcursor_size = sys.argv[1:]
def q(value):
    return "\"" + value.replace("\\", "\\\\").replace("\"", "\\\"") + "\""
print(
    f"hl.env(\"XCURSOR_THEME\", {q(theme)}); "
    f"hl.env(\"HYPRCURSOR_THEME\", {q(theme)}); "
    f"hl.env(\"XCURSOR_SIZE\", {q(xcursor_size)}); "
    f"hl.env(\"HYPRCURSOR_SIZE\", {q(hypr_size)})"
)
' "$theme" "$hypr_size" "$xcursor_size")
  # hyprctl setenv does not reach dispatcher environment. hl.env does.
  hyprctl eval "$lua" >/dev/null
  # VAR=VAL would split on "=" inside a theme name. Set the four values in this
  # command's environment and publish those names only, not the inherited environ.
  XCURSOR_THEME=$theme XCURSOR_SIZE=$xcursor_size HYPRCURSOR_THEME=$theme HYPRCURSOR_SIZE=$hypr_size \
    dbus-update-activation-environment --systemd \
      XCURSOR_THEME XCURSOR_SIZE HYPRCURSOR_THEME HYPRCURSOR_SIZE
  xsetroot -cursor_name left_ptr >/dev/null 2>&1 || true
}

# The launcher was started at login and still has the old cursor environment.
# Scopes copy that environment. Restart from systemd so killing the bar does
# not cancel the restart. The new shell is spawned by Hyprland and inherits
# the hl.env values just published.
restart_launcher() {
  if ! command -v omarchy >/dev/null 2>&1; then
    return 0
  fi
  systemd-run --user --collect --quiet --no-block \
    --unit="omarchy-cursor-shell-restart-$$" \
    omarchy restart shell >/dev/null 2>&1 || true
}

# theme is the menu name (gsettings). inherits is the directory Hyprland and
# Xcursor can load. sync_gsettings_theme writes inherits back during setcursor,
# so the user-facing name has to be restored afterwards.
apply_cursor() {
  local theme=$1 inherits=$2 size=$3
  local logical xcursor scale
  local -a sizes=()
  if [[ -z $inherits || $inherits == default ]]; then
    inherits=Adwaita
  fi
  if [[ ! $size =~ ^[1-9][0-9]*$ ]]; then
    echo "omarchy-cursor-set: refusing to apply cursor size: ${size:-<empty>}" >&2
    return 1
  fi
  logical=$size
  xcursor=$size
  mapfile -t sizes < <(theme_sizes "$inherits")
  if (( ${#sizes[@]} )); then
    logical=$(nearest_size "$size" "${sizes[@]}")
    scale=$(monitor_scale)
    xcursor=$(python3 -c 'import sys; print(float(sys.argv[1]) * float(sys.argv[2]))' "$logical" "$scale")
    xcursor=$(nearest_size "$xcursor" "${sizes[@]}")
  fi
  if [[ $logical != "$size" ]]; then
    echo "Cursor size $size is not in $inherits; using $logical." >&2
  fi
  hyprctl setcursor "$inherits" "$logical"
  gsettings set org.gnome.desktop.interface cursor-theme "$theme"
  gsettings set org.gnome.desktop.interface cursor-size "$logical"
  persist_hypr "$inherits" "$logical" "$xcursor"
  write_desktop_cursor "$theme" "$logical" "$inherits"
  publish_cursor_env "$inherits" "$logical" "$xcursor"
  python3 "$SCRIPT_DIR/omarchy-cursor-menu" --reload
  restart_launcher
}

# Keep the override in a marked block so the commented input.lua template stays
# untouched. 0 removes the block and returns to Omarchy's sensitivity.
persist_speed() {
  local speed=$1
  python3 - "$HYPR_INPUT" "$speed" << 'PY'
import os, sys
path, speed = sys.argv[1:]
begin = "-- BEGIN omarchy-cursor-set pointer speed"
end = "-- END omarchy-cursor-set pointer speed"

def strip_block(text):
    lines = text.splitlines(keepends=True)
    start = stop = None
    for i, line in enumerate(lines):
        if line.startswith(begin):
            start = i
        elif start is not None and line.startswith(end):
            stop = i
            break
    if start is None or stop is None:
        return text
    drop_from = start - 1 if start > 0 and lines[start - 1].strip() == "" else start
    del lines[drop_from:stop + 1]
    return "".join(lines)

text = open(path).read() if os.path.exists(path) else ""
text = strip_block(text)
if speed != "0":
    if text and not text.endswith("\n"):
        text += "\n"
    if text and not text.endswith("\n\n"):
        text += "\n"
    text += (
        f"{begin}\n"
        "hl.config({\n"
        "  input = {\n"
        f"    sensitivity = {speed},\n"
        "  },\n"
        "})\n"
        f"{end}\n"
    )
if os.path.exists(path) and open(path).read() == text:
    print("unchanged")
    raise SystemExit(0)
os.makedirs(os.path.dirname(path), exist_ok=True)
open(path, "w").write(text)
print("changed")
PY
}

apply_speed() {
  local speed=$1 normalized status errors backup
  if ! normalized=$(python3 -c '
import math, sys
try:
    value = float(sys.argv[1])
except ValueError:
    raise SystemExit(2)
if not math.isfinite(value) or value < -1 or value > 1:
    raise SystemExit(2)
steps = (-1, -0.75, -0.5, -0.25, 0, 0.25, 0.5, 0.75, 1)
for step in steps:
    if abs(value - step) < 0.001:
        value = step
        break
if abs(value) < 1e-9:
    print("0")
elif abs(value - round(value)) < 1e-9:
    print(int(round(value)))
else:
    print(f"{value:.4f}".rstrip("0").rstrip("."))
' "$speed"); then
    echo "Usage: omarchy-cursor-set --speed <sensitivity>" >&2
    echo "Sensitivity is from -1 to 1. 0 is Omarchy's default." >&2
    exit 2
  fi
  local created=0 before errors
  backup=$(mktemp /tmp/opencode/cursor-speed.XXXXXX)
  if [[ -f $HYPR_INPUT ]]; then
    cp "$HYPR_INPUT" "$backup"
  else
    created=1
    : > "$backup"
  fi
  before=$(hyprctl configerrors 2>&1 || true)
  status=$(persist_speed "$normalized")
  if [[ $status == changed ]]; then
    if ! hyprctl reload >/dev/null 2>&1; then
      errors="reload failed"
    else
      errors=$(hyprctl configerrors 2>&1 || true)
    fi
    if [[ ${errors-} == "reload failed" || "$errors" != "$before" ]]; then
      if [[ $created -eq 1 ]]; then
        rm -f "$HYPR_INPUT"
      else
        cp "$backup" "$HYPR_INPUT"
      fi
      hyprctl reload >/dev/null 2>&1 || true
      rm -f "$backup"
      echo "Hyprland rejected the pointer speed change." >&2
      if [[ $errors != "reload failed" && -n ${errors//[[:space:]]/} ]]; then
        printf '%s\n' "$errors" >&2
      fi
      exit 1
    fi
  fi
  rm -f "$backup"
  hyprctl eval "hl.config({ input = { sensitivity = ${normalized} } })" >/dev/null
}

cmd=$(basename "$0")
if [[ ${1-} == --current || $cmd == omarchy-cursor-current ]]; then
  cursor_current
  exit 0
fi

if [[ $cmd == omarchy-cursor-size && $# -eq 0 ]]; then
  cursor_size
  exit 0
fi

if [[ $cmd == omarchy-cursor-speed && $# -eq 0 ]]; then
  cursor_speed
  exit 0
fi

if [[ ${1-} == --default ]]; then
  apply_cursor default "$(hypr_theme default)" 24
  exit 0
fi

if [[ ${1-} == --size ]]; then
  size=${2-}
  if [[ ! $size =~ ^[1-9][0-9]*$ ]]; then
    echo "Usage: omarchy-cursor-set --size <pixels>" >&2
    exit 2
  fi
  theme=$(cursor_current)
  if [[ -z $theme ]]; then
    echo "No cursor theme is selected. Pick a theme first." >&2
    exit 1
  fi
  apply_cursor "$theme" "$(hypr_theme "$theme")" "$size"
  exit 0
fi

if [[ ${1-} == --speed ]]; then
  if [[ $# -lt 2 ]]; then
    echo "Usage: omarchy-cursor-set --speed <sensitivity>" >&2
    echo "Sensitivity is from -1 to 1. 0 is Omarchy's default." >&2
    exit 2
  fi
  apply_speed "$2"
  exit 0
fi

theme=${1-}
if [[ -z $theme || $theme == -* || $theme == */* || $theme == *..* ]]; then
  echo "Usage: omarchy-cursor-set <theme-directory-name>" >&2
  echo "       omarchy-cursor-set --size <pixels>" >&2
  echo "       omarchy-cursor-set --speed <sensitivity>" >&2
  echo "       omarchy-cursor-set --default" >&2
  echo "       omarchy-cursor-current" >&2
  exit 2
fi

found=
for dir in "$HOME/.local/share/icons" "$HOME/.icons" /usr/share/icons; do
  if [[ -d $dir/$theme/cursors ]]; then
    found=1
    break
  fi
done
if [[ -z $found ]]; then
  echo "Cursor theme not found: $theme" >&2
  exit 1
fi

apply_cursor "$theme" "$(hypr_theme "$theme")" "$(cursor_size)"
