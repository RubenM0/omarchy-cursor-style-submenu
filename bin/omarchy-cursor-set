#!/bin/bash
# Apply an Xcursor theme or size and keep it across login.
# omarchy-cursor-current prints the active theme name.
# omarchy-cursor-size prints the active size.

set -euo pipefail

HYPR_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.lua"

cursor_current() {
  local theme
  theme=$(gsettings get org.gnome.desktop.interface cursor-theme 2>/dev/null || true)
  theme=${theme#\'}
  theme=${theme%\'}
  printf '%s\n' "$theme"
}

cursor_size() {
  local size
  size=$(gsettings get org.gnome.desktop.interface cursor-size 2>/dev/null || true)
  size=${size//[^0-9]/}
  if [[ -z $size && -f $HYPR_CONFIG ]]; then
    size=$(sed -n 's/^hl.env("XCURSOR_SIZE", "\([0-9][0-9]*\)").*/\1/p' "$HYPR_CONFIG" | head -1)
  fi
  printf '%s\n' "${size:-32}"
}

persist_hypr() {
  local theme=$1 size=$2 what=$3
  python3 - "$HYPR_CONFIG" "$theme" "$size" "$what" << 'PY'
import os, re, sys
path, theme, size, what = sys.argv[1:]
lua = theme.replace("\\", "\\\\").replace('"', '\\"')
text = open(path).read() if os.path.exists(path) else ""
if text and not text.endswith("\n"):
    text += "\n"
replacements = {}
if what in ("theme", "both"):
    replacements["XCURSOR_THEME"] = f'hl.env("XCURSOR_THEME", "{lua}")\n'
    replacements["HYPRCURSOR_THEME"] = f'hl.env("HYPRCURSOR_THEME", "{lua}")\n'
if what in ("size", "both"):
    replacements["XCURSOR_SIZE"] = f'hl.env("XCURSOR_SIZE", "{size}")\n'
    replacements["HYPRCURSOR_SIZE"] = f'hl.env("HYPRCURSOR_SIZE", "{size}")\n'
for key, repl in replacements.items():
    pat = re.compile(rf'^hl\.env\("{key}", ".*"\)\n', re.M)
    if pat.search(text):
        text = pat.sub(repl, text, count=1)
    else:
        text += repl
os.makedirs(os.path.dirname(path), exist_ok=True)
open(path, "w").write(text)
PY
}

cmd=$(basename "$0")
if [[ ${1-} == --current || $cmd == omarchy-cursor-current ]]; then
  cursor_current
  exit 0
fi

if [[ $cmd == omarchy-cursor-size && $# -eq 0 ]]; then
  cursor_size
  exit 0
fi

if [[ ${1-} == --size ]]; then
  size=${2-}
  if [[ ! $size =~ ^[1-9][0-9]*$ ]]; then
    echo "Usage: omarchy-cursor-set --size <pixels>" >&2
    exit 2
  fi
  theme=$(cursor_current)
  if [[ -n $theme ]]; then
    hyprctl setcursor "$theme" "$size"
  fi
  gsettings set org.gnome.desktop.interface cursor-size "$size"
  persist_hypr "$theme" "$size" size
  exit 0
fi

theme=${1-}
if [[ -z $theme || $theme == -* || $theme == */* || $theme == *..* ]]; then
  echo "Usage: omarchy-cursor-set <theme-directory-name>" >&2
  echo "       omarchy-cursor-set --size <pixels>" >&2
  echo "       omarchy-cursor-current" >&2
  exit 2
fi

found=
for dir in "$HOME/.local/share/icons" "$HOME/.icons" /usr/share/icons; do
  if [[ -d $dir/$theme/cursors ]]; then
    found=1
    break
  fi
done
if [[ -z $found ]]; then
  echo "Cursor theme not found: $theme" >&2
  exit 1
fi

size=$(cursor_size)
hyprctl setcursor "$theme" "$size"
gsettings set org.gnome.desktop.interface cursor-theme "$theme"
gsettings set org.gnome.desktop.interface cursor-size "$size"
persist_hypr "$theme" "$size" theme
